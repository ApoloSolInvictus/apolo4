{
  "name": "apolo4",
  "version": "0.1.5",
  "private": true,
  "description": "Apolo4 - reproductor musical y locución comercial para tiendas",
  "author": "Apolo4",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "site:dev": "vite website --host 127.0.0.1 --port 4173 --strictPort",
    "site:build": "vite build website --outDir dist --emptyOutDir",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.apolo4.player",
    "productName": "Apolo4",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Apolo4-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Apolo4-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/uninstaller-sidebar.bmp",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apolo4",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
